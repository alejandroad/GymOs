# GymOs environment variables.
#
# Copy this file to apps/web/.env.local (gitignored) and fill in the values.
# Next.js and the db:* scripts in packages/db both read that file. On a host
# such as Vercel, set the same variables in the project settings instead.
# Every variable is validated by apps/web/src/env.ts.

# Neon Postgres connection string. Use the pooled connection string from the
# Neon console ("Connection pooling" on; the host contains "-pooler").
# Required.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Set to 1 to skip env validation, for CI builds that have no secrets.
# Code that uses a missing value still fails at runtime. Never set this in
# production.
# SKIP_ENV_VALIDATION=1
